{
  "name": "nettiva",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "cf:types": "wrangler types",
    "cf:login": "wrangler login",
    "cf:create-db": "wrangler d1 create nettiva --binding DB --update-config",
    "cf:migrate": "wrangler d1 migrations apply nettiva --remote",
    "cf:secret:username": "wrangler secret put NETTIVA_USERNAME",
    "cf:secret:password": "wrangler secret put NETTIVA_PASSWORD",
    "cf:secret:ebay-client-id": "wrangler secret put EBAY_CLIENT_ID",
    "cf:secret:ebay-client-secret": "wrangler secret put EBAY_CLIENT_SECRET",
    "cf:secret:ebay-redirect-uri": "wrangler secret put EBAY_REDIRECT_URI",
    "cf:secret:token-key": "wrangler secret put EBAY_TOKEN_ENCRYPTION_KEY",
    "deploy": "npm run check && npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.57.0",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.39.0",
    "better-auth": "^1.7.2"
  }
}
